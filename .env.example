# Copy this file to .env and fill in your actual key. .env is gitignored —
# never commit real keys. ANTHROPIC_API_KEY is assumed to already be set as a
# system environment variable (used by the existing generation pipeline) and
# does not need to go here.

# Gemini API key, used ONLY by the post-hoc thematic-coding script
# (scripts/thematic_coding.py) — never read by the generation pipeline
# (core/, prompts/, run_session.py). Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Evaluator-comparison keys (used by run_evaluator_comparison.py only).
# GEMINI_API_KEY_25:   key for the "Dissertation Thematic Analysis" project (gemini-2.5-flash,
#                      billing enabled). This is the validated evaluator used in production.
# GEMINI_API_KEY_NEXT: key for the second project (gemini-3.5-flash, free tier).
GEMINI_API_KEY_25=
GEMINI_API_KEY_NEXT=

# Optional backup Gemini key (different Google account / project).
# Used automatically if the primary key hits a 429 quota-exhaustion error.
# Leave blank if you only have one key.
GOOGLE_API_KEY_BACKUP=

# Model to use with the backup key. Needed when the backup project is "new" and
# doesn't have access to the primary model (e.g. gemini-2.5-flash is restricted
# to legacy projects). Check Google AI Studio for the model name available in
# your backup project. Leave blank to use the same model as the primary key.
# Common options: gemini-2.5-flash-latest  gemini-2.0-flash
GOOGLE_API_KEY_BACKUP_MODEL=
